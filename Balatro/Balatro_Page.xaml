<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Balatro.Balatro_Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Balatro"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converter="using:Balatro.Converter"
    xmlns:model="using:Balatro.Models">

    <Page.Resources>
        <converter:EnumToStringConverter x:Key="EnumDescription"/>
        <converter:IntValueEnumKeyDictConverter x:Key="IntValue"/>
        <converter:VisibleOver0 x:Key="Over0"/>
    </Page.Resources>
    
    <Grid Name="BaseGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="74*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Name="SpaceGrid" Background="Green"/>

        <Grid Name="InfoGrid" Grid.Column="1" Background="#2f3a39" BorderThickness="2,0,2,0" BorderBrush="{x:Bind game.BlindColor}">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Name="NameGrid" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Name="BlindName" Grid.Row="0" Text="{x:Bind ConvertRoundToBlind(game.Round), Mode=OneWay}"/>


                <Border Name="InnerNameGridBorder" Grid.Row="1">
                    <Border.Background>
                        <ImageBrush Stretch="Fill"/>
                    </Border.Background>
                    
                    <Grid Name="InnerNameGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Image Name="BlindImage" Grid.Column="0"/>


                        <TextBlock Name="MinimumScore" Grid.Column="1" Text="{x:Bind game.Threshold, Mode=OneWay}"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource DarkContainer}" Name="ScoreBorder">
                <Grid Name="ScoreGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Round score" Grid.Column="0"/>
                    
                    <Border Grid.Column="1">
                        <Grid Name="RoundScoreGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="CurrentScore" Grid.Column="1" Text="{x:Bind game.Player.TotalChips, Mode=OneWay}"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>

                    </Border>
                    
                </Grid>
            </Border>
            

            <Border Style="{StaticResource DarkContainer}" Grid.Row="2" Name="CurrentSelectionInfoBorder">
                <Grid Name="HandInfoGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Name="InnerHandInfoGrid" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="HandName" Grid.Column="0" Text="{x:Bind game.Player.HighestHand, Mode=OneWay, Converter={StaticResource EnumDescription}}" 
                                   Visibility="{x:Bind game.Player.SelectedCards.Count, Mode=OneWay, Converter={StaticResource Over0}}"/>
                        <TextBlock Name="HandLevel" Grid.Column="1" Text="{x:Bind ConvertEnumDictToIntString(game.Player.HandLevels, game.Player.HighestHand), Mode=OneWay}"
                                   Visibility="{x:Bind game.Player.SelectedCards.Count, Mode=OneWay, Converter={StaticResource Over0}}"/>
                    </Grid>

                    <Grid Name="ScoreCalculationGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Name="ChipsBorder" Style="{StaticResource ChipsContainer}">
                            <TextBlock Name="Chips" Text="{x:Bind game.Player.Chips, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        
                        <TextBlock Text="X" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        
                        <Border Grid.Column="2" Name="MultiplierBorder" Style="{StaticResource MultiplierContainer}">
                            <TextBlock Name="Multiplier" Text="{x:Bind game.Player.Multiplier, Mode=OneWay}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        
                    </Grid>
                </Grid>
            </Border>
            
            <Grid Name="OtherGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button Name="RunInfo"  Content="Run Info" Grid.Row="0" Click="Show_RunInfo" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Button Name="Options" Content="Options" Grid.Row="1" Click="Show_Options" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Grid>

                <Grid Name="OtherInfo" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Name="RemainingHandsGrid"  Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Hands" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind game.Player.RemainingHands, Mode=OneWay}"/>
                    </Grid>
                    <Grid Name="RemainingDiscardsGrid" Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Discards" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind game.Player.Discards, Mode=OneWay}"/>
                    </Grid>

                    <TextBlock Name="Money" Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="0" Text="{x:Bind game.Player.Money, Mode=OneWay}"/>

                    <Grid Name="AnteGrid" Grid.Row="2" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ante" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind game.Ante, Mode=OneWay}"/>
                    </Grid>

                    <Grid Name="RoundGrid" Grid.Row="2" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Round" Grid.Row="0"/>
                        <TextBlock Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Name="PlayGrid" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Name="ConsumableAndJokerGrid" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
            </Grid>

            <Grid Name="TableGrid" Grid.Row="1" Background="Beige">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Name="CardGrid" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <GridView Name="SelectedCardsGridView" Grid.Row="0">

                    </GridView>

                    <GridView ItemsSource="{x:Bind game.Player.Cards, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" ItemClick="Card_Selected" IsItemClickEnabled="True" 
            SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="False" Name="PlayerCards" Grid.Row="1">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="model:Card">
                                <Image Source="{x:Bind Image}" Height="201" Width="150"/>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>


                    <TextBlock Name="CardCount" Grid.Row="3"/>

                    <Grid Name="ActionGrid" Grid.Row="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            
                            <Border Name="PlayCardsButtonBorder" Style="{StaticResource ChipsContainer}">
                                <Button Name="PlayCards" Content="Play Hand" Command="{x:Bind game.ConfirmCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="Transparent" FontFamily="{StaticResource PixelBig}" FontSize="54" BorderThickness="0" CornerRadius="0" 
                                        IsEnabledChanged="PlayHand_IsEnabledChanged"/>
                            </Border>

                            <Border Name="DiscardButtonBorder" Style="{StaticResource MultiplierContainer}">
                                <Button Name="DiscardCards" Content="Discard" Command="{x:Bind game.DiscardCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="Transparent" FontFamily="{StaticResource PixelBig}" FontSize="54" BorderThickness="0" CornerRadius="0" 
                                        IsEnabledChanged="DiscardCards_IsEnabledChanged"/>
                            </Border>
                            
                        </StackPanel>
                    </Grid>

                </Grid>

                <Grid Name="DeckAndTagGrid" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <ItemsControl Name="TagList" Grid.Row="0">

                    </ItemsControl>

                    <Grid Name="DeckGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
