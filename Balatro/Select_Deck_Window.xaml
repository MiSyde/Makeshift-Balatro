<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Balatro.Select_Deck_Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Balatro"
    xmlns:model="using:Balatro.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Select_Deck_Window"
    x:Name="Window">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView ItemsSource="{Binding Decks.Keys, Mode=OneWay}" Grid.Column="0" ItemClick="Display_Deck" IsItemClickEnabled="True" Grid.Row="0">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:IEffect">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" Visibility="{Binding ShowDetails, Mode=OneWay}">
            <TextBlock Text="{Binding PreviewDeck.Name}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding PreviewDeck.Image}"/>
                <TextBlock Grid.Column="1" Text="{Binding PreviewDeck.Description}"/>
            </Grid>
            <Border Style="{StaticResource ChipsContainer}" Width="60" Height="Auto">
                <Button Command="{Binding Path=SelectDeckCommand, ElementName=Window}" Content="Select Deck"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource NextRoundContainer}">
            <Button Content="Back" Click="Back_Click"/>
        </Border>
        
    </Grid>
</Window>
