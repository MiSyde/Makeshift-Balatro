<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Balatro.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Balatro"
    xmlns:deck="using:Balatro.Models.Decks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"  Margin="25, 100, 175, 100" Orientation="Horizontal">
            <TextBlock Text="Makeshift" FontSize="200" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource PixelBig}">
                <TextBlock.RenderTransform>
                    <CompositeTransform ScaleX="0.6" ScaleY="0.6" TranslateY="-4" TranslateX="-5"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Text="Balatro" FontFamily="{StaticResource PixelBig}" FontSize="500" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Select your deck" Click="Select_Deck"/>

            <Border Name="PlayButtonBorder" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100" Style="{StaticResource ChipsContainer}" Width="350" Height="200">
                <Button Content="Play" Command="{x:Bind PlayCommand}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" IsEnabledChanged="Play_IsEnabledChanged"
            FontFamily="{StaticResource PixelBig}" FontSize="150" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
            </Border>

            <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="100" Style="{StaticResource MultiplierContainer}" Width="350" Height="200">
                <Button Content="Exit" Click="Exit_Click" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0"
FontFamily="{StaticResource PixelBig}" FontSize="150" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>
</Page>
