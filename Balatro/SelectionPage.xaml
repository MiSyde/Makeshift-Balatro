<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Balatro.SelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Balatro"
    xmlns:tag="using:Balatro.Models.Tags"
    xmlns:model="using:Balatro.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Name="BaseGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="74*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Name="SpaceGrid"/>

        <Grid Name="InfoGrid" Grid.Column="1" Background="#2f3a39" BorderThickness="2,0,2,0" BorderBrush="{x:Bind Game.BlindColor}">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Choose your&#x0d;&#x0a;next Blind" FontFamily="{StaticResource PixelBig}" FontSize="54"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

            <Border Grid.Row="1" Style="{StaticResource DarkContainer}" Name="ScoreBorder">
                <Grid Name="ScoreGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="80*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Round&#x0d;&#x0a;score" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               FontFamily="{StaticResource PixelBig}" FontSize="24"/>

                    <Border Grid.Column="1">
                        <Grid Name="RoundScoreGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*"/>
                                <ColumnDefinition Width="50*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="CurrentScore" Grid.Column="1" Text="0"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>

                    </Border>

                </Grid>
            </Border>


            <Border Style="{StaticResource DarkContainer}" Grid.Row="2" Name="CurrentSelectionInfoBorder">
                <Grid Name="HandInfoGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Name="InnerHandInfoGrid" Grid.Row="0"/>

                    <Grid Name="ScoreCalculationGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Name="ChipsBorder" Style="{StaticResource ChipsContainer}">
                            <TextBlock Name="Chips" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="X" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <Border Grid.Column="2" Name="MultiplierBorder" Style="{StaticResource MultiplierContainer}">
                            <TextBlock Name="Multiplier" Text="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>

                    </Grid>
                </Grid>
            </Border>

            <Grid Name="OtherGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource RerollContainer}">
                        <Button Name="RunInfo"  Content="Run Info" Click="Show_RunInfo" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                FontFamily="{StaticResource PixelBig}" FontSize="24"/>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource NextRoundContainer}">
                        <Button Name="Options" Content="Options" Click="Show_Options" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                FontFamily="{StaticResource PixelBig}" FontSize="24"/>
                    </Border>
                    
                </Grid>

                <Grid Name="OtherInfo" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DarkContainer}" Grid.Row="0" Grid.Column="0">
                        <Grid Name="RemainingHandsGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30*"/>
                                <RowDefinition Height="70*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Hands" Grid.Row="0" FontSize="24" FontFamily="{StaticResource PixelBig}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border Grid.Row="1" Style="{StaticResource GrayShadowlessContainer}">
                                <TextBlock Text="{x:Bind Game.Player.RemainingHands, Mode=OneWay}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" FontFamily="{StaticResource PixelBig}" FontSize="54"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkContainer}">
                        <Grid Name="RemainingDiscardsGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30*"/>
                                <RowDefinition Height="70*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Discards" Grid.Row="0" FontFamily="{StaticResource PixelBig}" FontSize="24"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border Style="{StaticResource GrayShadowlessContainer}" Grid.Row="1">
                                <TextBlock Text="{x:Bind Game.Player.Discards, Mode=OneWay}" FontFamily="{StaticResource PixelBig}"
                                           FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            
                        </Grid>
                    </Border>
                    
                    <TextBlock Name="Money" Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="0" Text="{x:Bind Game.Player.Money, Mode=OneWay}"/>

                    <Grid Name="AnteGrid" Grid.Row="2" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ante" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind Game.Ante, Mode=OneWay}"/>
                    </Grid>

                    <Grid Name="RoundGrid" Grid.Row="2" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Round" Grid.Row="0"/>
                        <TextBlock Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Grid Name="SelectionGrid" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.2778*" />
                <RowDefinition Height="0.7222*"/>
            </Grid.RowDefinitions>

            <Grid Name="ConsumableAndJokerGrid" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <GridView Name="JokersGridView" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind Game.Player.Jokers}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:IEffect">
                            <Image Source="{x:Bind Image}" Height="201" Width="150"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Text="{x:Bind XDashY(Game.Player.Jokers.Count, Game.Player.MaxJokerCount)}" Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource PixelBig}" FontSize="18"/>

                <GridView Name="ConsumablesGridView" Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind Game.Player.Consumables}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:IEffect">
                            <Image Source="{x:Bind Image}" Height="201" Width="150"/>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind XDashY(Game.Player.Consumables.Count, Game.Player.MaxConsumableCount)}" FontFamily="{StaticResource PixelBig}" FontSize="18"/>

            </Grid>

            <Grid Name="TableGrid" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Name="SmallBlindBorder" Style="{StaticResource DarkContainer}">
                    <Grid Name="SmallBlind">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource GrayShadowlessContainer}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource SelectButtonContainer}">
                                    <Button Name="SelectSmallBlindButton" Content="Select" FontFamily="{StaticResource PixelBig}" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" 
                                        CornerRadius="0" Background="Transparent" FontSize="54" Command="{x:Bind SelectSmallBlindCommand}"/>
                                </Border>

                                <Border Grid.Row="1">
                                    <TextBlock Text="Small Blind"/>
                                </Border>

                                <Image Grid.Row="2" Source="/Assets/BlindImages/Small_Blind.png"/>

                                <Border Grid.Row="3" Style="{StaticResource DarkSmallShadowContainer}">
                                    <Grid >
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Score at least" Grid.Row="0"/>
                                        <TextBlock Text="{x:Bind Game.Threshold}" Grid.Row="1"/>
                                        <TextBlock Text="Reward" Grid.Row="2"/>
                                    </Grid>
                                </Border>
                                
                            </Grid>
                        </Border>

                        <TextBlock Text="or" FontFamily="{StaticResource PixelBig}" FontSize="54" Grid.Row="1"/>

                        <Border Grid.Row="2" Style="{StaticResource DarkShadowlessContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{x:Bind CurrentTags[0].Image}" Grid.Column="0"/>

                                <Border Style="{StaticResource NextRoundContainer}" Grid.Column="1">
                                    <Button Content="Skip Blind" FontFamily="{StaticResource PixelBig}" FontSize="46" BorderThickness="0" CornerRadius="0" Background="Transparent" Command="{x:Bind SkipSmallBlindCommand}" 
                                            CommandParameter="{x:Bind CurrentTags[0]}"/>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <Border Grid.Column="1" Name="BigBlindBorder" Style="{StaticResource DarkContainer}">
                    <Grid Name="BigBlind">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource GrayShadowlessContainer}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource SelectButtonContainer}">
                                    <Button Name="SelectBigBlindButton" Content="Select" FontFamily="{StaticResource PixelBig}" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="0" 
                        CornerRadius="0" Background="Transparent" FontSize="54" Command="{x:Bind SelectBigBlindCommand}"/>
                                </Border>

                                <Border Grid.Row="1">
                                    <TextBlock Text="Big Blind"/>
                                </Border>

                                <Image Grid.Row="2" Source="/Assets/BlindImages/Big_Blind.png"/>

                                <Border Grid.Row="3" Style="{StaticResource DarkSmallShadowContainer}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Score at least" Grid.Row="0"/>
                                        <TextBlock Text="{x:Bind Game.Threshold}" Grid.Row="1"/>
                                        <TextBlock Text="Reward" Grid.Row="1"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="or" FontFamily="{StaticResource PixelBig}" FontSize="54" Grid.Row="1"/>

                        <Border Grid.Row="2" Style="{StaticResource DarkShadowlessContainer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{x:Bind CurrentTags[1].Image}" Grid.Column="0"/>

                                <Border Style="{StaticResource NextRoundContainer}" Grid.Column="1">
                                    <Button Content="Skip Blind" FontFamily="{StaticResource PixelBig}" FontSize="46" BorderThickness="0" CornerRadius="0" Background="Transparent" Command="{x:Bind SkipBigBlindCommand}" 
                            CommandParameter="{x:Bind CurrentTags[1]}"/>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <Border Name="BossBlindBorder" Grid.Column="2">
                    <Border Name="BossBlind" Style="{StaticResource GrayShadowlessContainer}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource DarkShadowlessContainer}">
                                <TextBlock Text="{x:Bind Game.BossBlind.Name, Mode=OneWay}" FontFamily="{StaticResource PixelBig}" FontSize="46"/>
                            </Border>
                        
                        
                            <Image Grid.Row="1" Source="{x:Bind Game.BossBlind.Image, Mode=OneWay}" Width="100" Height="100"/>
                        
                            <TextBlock Grid.Row="2" Text="{x:Bind Game.BossBlind.Description, Mode=OneWay}"/>

                            <Border Grid.Row="3" Style="{StaticResource SelectButtonContainer}">
                                <Button Content="Select" Command="{x:Bind SelectBossBlindCommand}" CornerRadius="0" BorderThickness="0"
                                        Background="Transparent" FontFamily="{StaticResource PixelBig}" FontSize="54"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>

                <Grid Name="DeckAndTagGrid" Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <ItemsControl Name="TagList" Grid.Row="0" ItemsSource="{x:Bind Game.Player.Tags, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="BitmapImage">
                                <StackPanel Orientation="Vertical" >
                                    <Image Source="{x:Bind}" Height="80" Width="80"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Name="DeckGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Image Grid.Row="0" Source="{x:Bind Game.Player.Deck.Image}"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind XDashY(Game.Player.Deck.CurrentSize, Game.Player.Deck.MaxSize)}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
