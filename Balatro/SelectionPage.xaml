<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Balatro.SelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Balatro"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Name="BaseGrid">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="23*"/>
            <ColumnDefinition Width="74*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Name="SpaceGrid" Background="Green"/>

        <Grid Name="InfoGrid" Grid.Column="1" Background="#2f3a39" BorderThickness="2,0,2,0" BorderBrush="{x:Bind Game.BlindColor}">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Choose your next Blind" FontFamily="{StaticResource PixelBig}" FontSize="54"/>

            <Border Grid.Row="1" Style="{StaticResource DarkContainer}" Name="ScoreBorder">
                <Grid Name="ScoreGrid" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Round score" Grid.Column="0"/>

                    <Border Grid.Column="1">
                        <Grid Name="RoundScoreGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Name="CurrentScore" Grid.Column="1" Text="0"  VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Grid>

                    </Border>

                </Grid>
            </Border>


            <Border Style="{StaticResource DarkContainer}" Grid.Row="2" Name="CurrentSelectionInfoBorder">
                <Grid Name="HandInfoGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid Name="InnerHandInfoGrid" Grid.Row="0"/>

                    <Grid Name="ScoreCalculationGrid" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Name="ChipsBorder" Style="{StaticResource ChipsContainer}">
                            <TextBlock Name="Chips" Text="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="X" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <Border Grid.Column="2" Name="MultiplierBorder" Style="{StaticResource MultiplierContainer}">
                            <TextBlock Name="Multiplier" Text="0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>

                    </Grid>
                </Grid>
            </Border>

            <Grid Name="OtherGrid" Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Button Name="RunInfo"  Content="Run Info" Grid.Row="0" Click="Show_RunInfo" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Button Name="Options" Content="Options" Grid.Row="1" Click="Show_Options" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Grid>

                <Grid Name="OtherInfo" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid Name="RemainingHandsGrid"  Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Hands" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind Game.Player.RemainingHands, Mode=OneWay}"/>
                    </Grid>
                    <Grid Name="RemainingDiscardsGrid" Grid.Row="0" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Discards" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind Game.Player.Discards, Mode=OneWay}"/>
                    </Grid>

                    <TextBlock Name="Money" Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="0" Text="{x:Bind Game.Player.Money, Mode=OneWay}"/>

                    <Grid Name="AnteGrid" Grid.Row="2" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ante" Grid.Row="0"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind Game.Ante, Mode=OneWay}"/>
                    </Grid>

                    <Grid Name="RoundGrid" Grid.Row="2" Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Round" Grid.Row="0"/>
                        <TextBlock Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>





        <Grid Name="SelectionGrid" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Name="ConsumableAndJokerGrid" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <GridView Name="JokersGridView" Grid.Row="0" Grid.Column="0" ItemsSource="{x:Bind Game.Player.Jokers}">

                </GridView>

                <TextBlock Text="{x:Bind XDashY(Game.Player.Jokers.Count, Game.Player.MaxJokerCount)}" Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource PixelBig}" FontSize="18"/>

                <GridView Name="ConsumablesGridView" Grid.Row="0" Grid.Column="1" ItemsSource="{x:Bind Game.Player.Consumables}">

                </GridView>

                <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind XDashY(Game.Player.Consumables.Count, Game.Player.MaxConsumableCount)}" FontFamily="{StaticResource PixelBig}" FontSize="18"/>

            </Grid>

            <Grid Name="TableGrid" Grid.Row="1" Background="Beige">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="Green"/>
                <?empty column?>

                <Grid Name="SmallBlind" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Small Blind"/>

                    <Image Grid.Row="1" Source="/Assets/BlindImages/Small_Blind.png"/>

                    <Border Grid.Row="2" Style="{StaticResource ChipsContainer}">
                        <Button Content="Select" FontFamily="{StaticResource PixelBig}" FontSize="54" Command="{x:Bind SelectSmallBlindCommand}"/>
                    </Border>
                    
                </Grid>
                
                <Grid Grid.Column="2" Background="Green"/>
                <?empty column?>

                <Grid Name="BigBlind" Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Small Blind"/>

                    <Image Grid.Row="1" Source="/Assets/BlindImages/Big_Blind.png"/>
                    
                    <Button Grid.Row="2" Content="Select" Command="{x:Bind SelectBigBlindCommand}"/>
                </Grid>

                <Grid Grid.Column="4" Background="Green"/>
                <?empty column?>
                
                <Grid Name="BossBlind" Grid.Column="5">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Bind Game.BossBlind.Name, Mode=OneWay}"/>
                    <Image Grid.Row="1" Source="{x:Bind Game.BossBlind.Image, Mode=OneWay}"/>
                    <TextBlock Grid.Row="2" Text="{x:Bind Game.BossBlind.Description, Mode=OneWay}"/>
                    <Button Grid.Row="3" Content="Select" Command="{x:Bind SelectBossBlindCommand}"/>
                </Grid>

                <Grid Name="DeckAndTagGrid" Grid.Column="6">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <ItemsControl Name="TagList" Grid.Row="0">

                    </ItemsControl>

                    <Grid Name="DeckGrid" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Image Grid.Row="0" Source="{x:Bind Game.Player.Deck.Image}"/>
                        <TextBlock Grid.Row="1" Text="{x:Bind XDashY(Game.Player.Deck.CurrentSize, Game.Player.Deck.MaxSize)}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
